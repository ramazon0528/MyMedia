<Window x:Class="MyMedia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyMedia.ViewModels.Windows"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:MyMedia"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="{x:Null}"
        Title="MainWindow"
        Height="600" Width="1000"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{DynamicResource AppBackground}"
            CornerRadius="10">
        <Grid>
            <StackPanel Grid.ColumnSpan="2"
                        VerticalAlignment="Top"
                        Height="25"
                        Margin="0 7 0 0"
                        Orientation="Horizontal"
                        FlowDirection="RightToLeft">

                <Button Style="{DynamicResource CloseButton}"
                        Command="{Binding CloseCommand}"/>

                <Button Style="{DynamicResource MaximizeButton}"
                        Command="{Binding MaximizeCommand}"/>

                <Button Style="{DynamicResource MinimizeButton}"
                        Command="{Binding MinimizeCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <md:PackIcon Kind="MovieOpen"
                             Margin="10 10 0 5"
                             Width="20" Height="20"
                             Foreground="{DynamicResource PrimaryColor}"/>

                <TextBlock Text="Media Vault"
                           VerticalAlignment="Top"
                           Margin="10"
                           Foreground="{DynamicResource White}"
                           Style="{DynamicResource HeaderL}"/>
            </StackPanel>

            <Grid Margin="0 35 0 0">

                <Border Style="{DynamicResource MenuBorder}"
                        Width="60"
                        Name="Menu">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <Rectangle Style="{DynamicResource HorizontalRectangle}"
                                   Grid.Row="1"
                                   VerticalAlignment="Top"/>

                        <RadioButton Grid.Row="1"
                                     Style="{DynamicResource MenuRadioButton}"
                                     Command="{Binding NavigateToSettingsPageCommand}">
                            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=ActualWidth}">
                                <md:PackIcon Kind="Settings"
                                             Width="20" Height="20"
                                             Margin="10"/>

                                <TextBlock Text="Настройки" 
                                           Style="{DynamicResource MenuRadioButtonName}"
                                           Margin="50 0 0 0"/>
                            </Grid>
                        </RadioButton>

                        <StackPanel>

                            <Grid>
                                <ToggleButton Style="{DynamicResource MenuToggleButton}">
                                    <ToggleButton.Triggers>
                                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Menu"
                                                                     Storyboard.TargetProperty="Width"
                                                                     From="60" To="250"
                                                                     Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction>
                                                            <PowerEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ThicknessAnimation Storyboard.TargetName="Content"
                                                                     Storyboard.TargetProperty="Margin"
                                                                     From="80 0 10 10" To="270 0 10 10"
                                                                     Duration="0:0:0.5">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <PowerEase EasingMode="EaseOut"/>
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Menu"
                                                                     Storyboard.TargetProperty="Width"
                                                                     From="250" To="60"
                                                                     Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction>
                                                            <PowerEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ThicknessAnimation Storyboard.TargetName="Content"
                                                                        Storyboard.TargetProperty="Margin"
                                                                        From="270 0 10 10" To="80 0 10 10"
                                                                        Duration="0:0:0.5">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <PowerEase EasingMode="EaseOut"/>
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ToggleButton.Triggers>
                                </ToggleButton>

                                <TextBlock Style="{DynamicResource HeaderXL}"
                                           Text="Menu"
                                           HorizontalAlignment="Right"
                                           Margin="0 0 180 0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Style="{DynamicResource HorizontalRectangle}"/>

                            <RadioButton Style="{DynamicResource MenuRadioButton}"
                                         Command="{Binding NavigateToMediaPageCommand}"
                                         Margin="10 20 10 5">
                                <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=ActualWidth}">
                                    <md:PackIcon Kind="Multimedia"
                                                 Width="20" Height="20"
                                                 Margin="10"/>

                                    <TextBlock Text="Мультимедия" 
                                               Style="{DynamicResource MenuRadioButtonName}"
                                               Margin="50 0 0 0"/>
                                </Grid>
                            </RadioButton>
                        
                            <RadioButton Style="{DynamicResource MenuRadioButton}"
                                         Command="{Binding NavigateToCategoryPageCommand}">
                                <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=ActualWidth}">
                                    <md:PackIcon Kind="AnimationPlay"
                                                 Width="20" Height="20"
                                                 Margin="10"/>

                                    <TextBlock Text="Категории" 
                                               Style="{DynamicResource MenuRadioButtonName}"
                                               Margin="50 0 0 0"/>
                                </Grid>
                            </RadioButton>
                        
                            <RadioButton Style="{DynamicResource MenuRadioButton}"
                                         Command="{Binding NavigateToGenrePageCommand}">
                                <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=ActualWidth}">
                                    <md:PackIcon Kind="Ghost"
                                                 Width="20" Height="20"
                                                 Margin="10"/>

                                    <TextBlock Text="Жанры" 
                                               Style="{DynamicResource MenuRadioButtonName}"
                                               Margin="50 0 0 0"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Content="{Binding Navigator.ViewModel}"
                                x:Name="Content"
                                Margin="80 0 10 10"/>
            </Grid>
        </Grid>
    </Border>
    
</Window>
