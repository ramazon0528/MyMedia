<UserControl x:Class="MyMedia.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyMedia.Views.Pages"
             xmlns:vm="clr-namespace:MyMedia.ViewModels.Pages"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Border Background="{DynamicResource BackgroundPrimary}"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Rectangle Style="{DynamicResource HorizontalRectangle}"
                       VerticalAlignment="Bottom"/>
            
            <Rectangle Style="{DynamicResource HorizontalRectangle}"
                       VerticalAlignment="Top"
                       Grid.Row="2"/>

            <TextBlock Text="Настройки"
                       Style="{DynamicResource HeaderXL}"/>

            <StackPanel Grid.Row="1"
                        Margin="10">
                <Grid>
                    <TextBlock Text="Настройка темы"
                               Style="{DynamicResource HeaderL}"/>

                    <ComboBox Style="{DynamicResource MainComboBox}"
                              HorizontalAlignment="Right"
                              MinWidth="200"
                              Tag="Тема"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"/>
                </Grid>
            </StackPanel>

            <Button Style="{DynamicResource BigPrimaryButton}"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Width="200"
                    Content="Сохранить"
                    Command="{Binding SaveSettingsCommand}"/>
        </Grid>
    </Border>
</UserControl>
