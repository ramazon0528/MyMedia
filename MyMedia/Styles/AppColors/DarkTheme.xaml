<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="PrimaryColor" Color="#F162AA"/>
    <SolidColorBrush x:Key="PrimaryColorHover" Color="#F471B9"/>
    <SolidColorBrush x:Key="PrimaryColorPressed" Color="#D85BA0"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#7974B5"/>

    <SolidColorBrush x:Key="BackgroundPrimary" Color="#221A49"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#262253"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#272759"/>
    <SolidColorBrush x:Key="BackgroundControl" Color="#2E2C60"/>

    <SolidColorBrush x:Key="BackgroundHover" Color="#2D295F"/>
    <SolidColorBrush x:Key="BackgroundPressed" Color="#1B1A42"/>

    <SolidColorBrush x:Key="ForegroundPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#B8B5D0"/>

    <SolidColorBrush x:Key="Danger" Color="#FF406E"/>
    <SolidColorBrush x:Key="DangerHover" Color="#F94851"/>
    <SolidColorBrush x:Key="DangerPressed" Color="#F23B4D"/>
    <SolidColorBrush x:Key="Warning" Color="#FFDC48"/>
    <SolidColorBrush x:Key="Info" Color="#00C3FF"/>
</ResourceDictionary>