<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Color.Primary" Color="#F162AA"/>
    <SolidColorBrush x:Key="Color.Secondary" Color="#7974B5"/>

    <SolidColorBrush x:Key="Background.Primary" Color="#303030"/>
    <SolidColorBrush x:Key="Background.Secondary" Color="#262253"/>
    <SolidColorBrush x:Key="Background.Tertiary" Color="#272759"/>
    <SolidColorBrush x:Key="Background.Control" Color="#2E2C60"/>

    <SolidColorBrush x:Key="Background.Hover" Color="#2D295F"/>
    <SolidColorBrush x:Key="Background.Pressed" Color="#1B1A42"/>

    <SolidColorBrush x:Key="Foreground.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Foreground.Secondary" Color="#B8B5D0"/>

    <SolidColorBrush x:Key="Accent.Red" Color="#FF406E"/>
    <SolidColorBrush x:Key="Accent.Yellow" Color="#FFDC48"/>
    <SolidColorBrush x:Key="Accent.Magenta" Color="#FF0050"/>
</ResourceDictionary>