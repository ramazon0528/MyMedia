<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="PrimaryColor" Color="#fff"/>
    <SolidColorBrush x:Key="PrimaryColorHover" Color="#fff"/>
    <SolidColorBrush x:Key="PrimaryColorPressed" Color="#fff"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#fff"/>

    <SolidColorBrush x:Key="BackgroundPrimary" Color="#fff"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#fff"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#fff"/>
    <SolidColorBrush x:Key="BackgroundControl" Color="#fff"/>

    <SolidColorBrush x:Key="BackgroundHover" Color="#fff"/>
    <SolidColorBrush x:Key="BackgroundPressed" Color="#fff"/>

    <SolidColorBrush x:Key="ForegroundPrimary" Color="#fff"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#fff"/>

    <SolidColorBrush x:Key="Danger" Color="#fff"/>
    <SolidColorBrush x:Key="DangerHover" Color="#fff"/>
    <SolidColorBrush x:Key="DangerPressed" Color="#fff"/>
    <SolidColorBrush x:Key="Warning" Color="#fff"/>
    <SolidColorBrush x:Key="Info" Color="#fff"/>
    <SolidColorBrush x:Key="White" Color="#fff"/>

    <LinearGradientBrush x:Key="AppBackground">
        <GradientStop Color="#fff" Offset="0"/>
        <GradientStop Color="#fff" Offset=".4"/>
        <GradientStop Color="#fff" Offset="1"/>
    </LinearGradientBrush>
    
</ResourceDictionary>