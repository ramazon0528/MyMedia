<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CategoryListBoxItem" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="10 5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BackgroundHover}"/>
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                         Value="True">
                <Setter Property="Background" Value="{DynamicResource BackgroundControl}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="MediaListBoxItem" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="220"/>
        <Setter Property="Margin" Value="10 5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BackgroundHover}"/>
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="MediaForm" TargetType="Border">
        <Setter Property="Width" Value="250"/>
        <Setter Property="Panel.ZIndex" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0 35 20 20"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColor}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="300"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="CategoryForm" TargetType="Border">
        <Setter Property="Width" Value="320"/>
        <Setter Property="Panel.ZIndex" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="5 10"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColor}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="350"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="MenuBorder">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="10 0 0 10"/>
        <Setter Property="Width" Value="250"/>
    </Style>
</ResourceDictionary>