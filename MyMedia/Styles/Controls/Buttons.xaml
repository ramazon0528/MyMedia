<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="BigButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Nunito"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryColorHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryColorPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="SquareButtonBase" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="5 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="SmallSquareButtonBase" TargetType="Button">
        <Setter Property="Width" Value="25"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Margin" Value="10 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SquareButton" TargetType="Button" BasedOn="{StaticResource SquareButtonBase}">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryColor}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BackgroundHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource BackgroundPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource SquareButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryColorHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryColorPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource SquareButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource SquareButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Info}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource InfoHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource InfoPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource SmallSquareButtonBase}">
        <Setter Property="Content" Value="{md:PackIcon Kind=Close,Size=15}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="MaximizeButton" TargetType="Button" BasedOn="{StaticResource SmallSquareButtonBase}">
        <Setter Property="Content" Value="{md:PackIcon Kind=Maximize,Size=15}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource InfoHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource InfoPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="MinimizeButton" TargetType="Button" BasedOn="{StaticResource SmallSquareButtonBase}">
        <Setter Property="Content" Value="{md:PackIcon Kind=Minimize,Size=15}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SuccessHover}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SuccessPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    
    
</ResourceDictionary>